<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's own group first, so that what it keeps without naming a
	     group (the pairing tokens) stays its own; the second holds only the
	     keys its notification service extension reads (#66). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<string>$(AppIdentifierPrefix)$(PUSH_KEYCHAIN_GROUP)</string>
	</array>
	<!-- A notification of an agent that asks, is done or stopped, shown
	     during a Focus too (#233). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
